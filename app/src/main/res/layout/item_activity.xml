<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActivityType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/green_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Fertilizer application" />

            <TextView
                android:id="@+id/tvActivityDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="10 Aug 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActivityExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/soil_brown"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Spent: KES 500.00"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvActivityNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Applied DAP fertilizer around the base of each plant."
            tools:visibility="visible" />

    </LinearLayout>
</androidx.cardview.widget.CardView>